{
  "name": "dsh-study-less",
  "version": "0.8.3",
  "description": "DSH study desk: knowledge base, learning paths with inline generation, spaced review and distilled insights",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "study",
    "spaced-repetition",
    "pdf"
  ],
  "files": [
    "lib",
    "dist-web",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "bin": {
    "dsh-study-less": "./web/cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bejohnself/dsh-study-less.git"
  },
  "homepage": "https://github.com/Bejohnself/dsh-study-less#readme",
  "bugs": {
    "url": "https://github.com/Bejohnself/dsh-study-less/issues"
  },
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "node web/build.mjs",
    "start:web": "node dist-web/server.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "node scripts/checks/all.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "pretest": "node scripts/check-docs.mjs",
    "prepublishOnly": "npm run build && npm run build:web"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.3.0-0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.5",
    "esbuild": "^0.25.0",
    "katex": "^0.19.1",
    "marked": "^18.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2"
  }
}
